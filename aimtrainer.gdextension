[configuration]

entry_symbol = "aimtrainer_library_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]

; Every architecture this project can be built for is listed, so a checkout with
; several builds in bin/ works on any of them. Godot picks the row matching the
; running binary; a missing file is simply skipped.

windows.debug.x86_64 = "res://bin/libaimtrainer.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libaimtrainer.windows.template_release.x86_64.dll"
windows.debug.x86_32 = "res://bin/libaimtrainer.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/libaimtrainer.windows.template_release.x86_32.dll"

linux.debug.x86_64 = "res://bin/libaimtrainer.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libaimtrainer.linux.template_release.x86_64.so"
linux.debug.x86_32 = "res://bin/libaimtrainer.linux.template_debug.x86_32.so"
linux.release.x86_32 = "res://bin/libaimtrainer.linux.template_release.x86_32.so"

macos.debug.x86_64 = "res://bin/libaimtrainer.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "res://bin/libaimtrainer.macos.template_release.x86_64.dylib"
macos.debug.arm64 = "res://bin/libaimtrainer.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://bin/libaimtrainer.macos.template_release.arm64.dylib"
macos.debug.universal = "res://bin/libaimtrainer.macos.template_debug.universal.dylib"
macos.release.universal = "res://bin/libaimtrainer.macos.template_release.universal.dylib"
